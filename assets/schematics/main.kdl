// Local Cartesian X-forward / Y-left / Z-up; not geographic ENU.
coordinate frame="ENU"
theme mode="dark"
timeline range="full"
telemetry_mode #true
environment {
    sun direction="(0.0709068347,0.0803703456,0.9942398244)" illuminance=60000 shadows=#true
    ambient scale=0.3
    sky color="(24,18,17)"
}
vsplit name="Ingenuity / 16 Sep 2023" {
    hsplit share=0.84 {
        viewport name="INGENUITY · FLIGHT 59 · 16 SEP 2023 · SOL 915 | CYAN NASA · ORANGE MC" share=0.73 active=#true near=0.03 fov=43 hdr=#true ev100=13.5 show_grid=#false show_view_cube=#true pos="display.world_pos.translate_world(4.5,-5.5,3.5)" look_at="display.world_pos.translate_world(0,0,-1.3)" up="(0,0,1)" {
            bloom preset="old_school" intensity=0.12 threshold=1.0
        }
        sensor_view "navcam.gray" name="NAVCAM · SIMULATED · 10 FPS" share=0.27
    }
    hsplit share=0.16 {
        component_monitor component_name="helicam.elapsed" name="ARCHIVE TIME / s" share=0.18
        component_monitor component_name="helicam.height" name="CYAN · NASA S2 HEIGHT / m" share=0.22
        component_monitor component_name="comparison.error" name="ORANGE MODEL · GAP / m" share=0.22
        component_monitor component_name="comparison.rmse" name="BEST MC · FIT RMSE / m" share=0.22
        component_monitor component_name="comparison.draws" name="MC CANDIDATES" share=0.16
        component_monitor component_name="comparison.winner" name="CURRENT MC WINNER" share=0.16
    }
}
object_3d orientation=absolute sensor_visible=#true display.world_pos {
    glb path="db:models/ingenuity.glb"
}
line_3d helicam.world_pos line_width=4.0 perspective=#false {
    color 92 230 250
    future_color 92 230 250 90
}
line_3d best.world_pos line_width=4.0 perspective=#false {
    color 255 181 91
    future_color 255 181 91 90
}
object_3d orientation=absolute sensor_visible=#false best.world_pos {
    sphere radius=0.07 { color 255 181 91; }
}
object_3d orientation=absolute "(0,0,0,1,0,0,-0.4)" {
    glb path="db:models/mars_terrain.glb" { visibility_range max=30000; }
}
object_3d orientation=absolute "(0,0,0,1,0,0,0)" {
    glb path="db:models/mars_flight59_terrain.glb" { visibility_range max=1000; }
}
